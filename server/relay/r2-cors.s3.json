{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "http://localhost:8787"
      ],
      "AllowedMethods": [
        "PUT",
        "GET",
        "HEAD"
      ],
      "AllowedHeaders": [
        "content-type",
        "content-length",
        "if-none-match",
        "if-match"
      ],
      "ExposeHeaders": [
        "ETag",
        "Content-Length"
      ],
      "MaxAgeSeconds": 300
    }
  ]
}
